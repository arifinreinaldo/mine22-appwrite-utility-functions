{
  "$schema": "https://appwrite.io/schemas/appwrite.json",
  "projectId": "694172460017e01592a1",
  "projectName": "Daily Cron Function",
  "functions": [
    {
      "$id": "daily-cron-function",
      "name": "Daily Cron Function",
      "runtime": "node-18.0",
      "execute": [],
      "events": [],
      "schedule": "59 23 * * *",
      "timeout": 60,
      "enabled": true,
      "logging": true,
      "entrypoint": "main.js",
      "commands": "npm install",
      "path": ".",
      "environment": "node",
      "variables": {
        "APPWRITE_API_KEY": "",
        "STORAGE_BUCKET_ID": "default",
        "FILE_MAX_AGE_SECONDS": "86400"
      }
    }
  ]
}
